{
  "title": "Line In Mixer",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Adds Move's audio",
        "input on top of this",
        "track's own sound.",
        "The sound generator",
        "keeps playing; MIX,",
        "SOURCE and MUTE only",
        "change the input.",
        "",
        "Put it in FX 1 of",
        "the slot. FX after",
        "it process both."
      ]
    },
    {
      "title": "Input source",
      "lines": [
        "Move gives Schwung",
        "ONE stereo input:",
        "line in (mic if no",
        "cable) OR USB-C",
        "audio. Pick it on",
        "Move: Sampling >",
        "input source.",
        "",
        "SOURCE here picks",
        "which strip (gain,",
        "level, filters, pan)",
        "is used. Set it to",
        "match Move. Both at",
        "once: not possible."
      ]
    },
    {
      "title": "MIX page",
      "lines": [
        "1 MIX: input amount",
        "2 AN LVL  3 USB LVL",
        "4 SOURCE: ANALOG or",
        " USB-C",
        "5 AN GN  6 USB GN",
        " -24..+24 dB",
        "7 DUCK: input dips",
        " while the sound",
        " generator plays",
        "8 MUTE: input off"
      ]
    },
    {
      "title": "TONE page",
      "lines": [
        "1 MIX (same knob)",
        "2 AN HPF 3 USB HPF",
        " 20 Hz = off",
        "4 AN LPF 5 USB LPF",
        " 20 kHz = off",
        "6 AN PAN 7 USB PAN",
        "8 WIDTH: 0% mono,",
        " 100% as is, 200%",
        " wide"
      ]
    },
    {
      "title": "Feedback guard",
      "lines": [
        "ANALOG + speaker +",
        "no line-in cable =",
        "Move's built-in mic",
        "hears the speaker.",
        "The input is muted",
        "then and STATE on",
        "the Info page shows",
        "FB GUARD. Plug in a",
        "cable or headphones."
      ]
    },
    {
      "title": "MIDI CC",
      "lines": [
        "Slot channel:",
        "CC20-27 MIX page",
        " knobs 1-8",
        "CC28-34 TONE page",
        " knobs 2-8",
        "0-127 = full range"
      ]
    }
  ]
}
